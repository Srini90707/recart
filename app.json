{
  "expo": {
    "name": "Recart",
    "slug": "Recart",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FEF5E6"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.recart.app",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#FEF5E6",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "splash": {
        "backgroundColor": "#FEF5E6",
        "image": "./assets/splash-icon.png",
        "resizeMode": "contain"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "recart",
    "plugins": [
      "expo-status-bar",
      "expo-font",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow ReCart to use your location to discover listings near you."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "7115598b-d782-4f9f-ae70-41e42b70bee5"
      }
    },
    "owner": "vasreddy"
  }
}
